+  /**
+   * Process-level status probe for containerized cores. The backend shares
+   * the 5GC container's PID namespace (compose `pid: "container:open5gs_5gc"`),
+   * so NF daemons (open5gs-amfd, open5gs-smfd, mongod, ...) are visible as
+   * plain /proc entries even though systemd knows nothing about them.
+   * Returns a status derived from /proc/<pid>/comm, or null if /proc itself
+   * is unreadable (caller keeps its previous fallback).
+   * Added for containerized 5GC deployments (single-container cores, shared PID ns).
+   */
+  private async getProcFsStatus(name: ServiceName, unitName: string): Promise<ServiceStatus | null> {
+    try {
+      const entries = fs.readdirSync('/proc').filter((e) => /^\d+$/.test(e));
+      let foundPid: number | null = null;
+      for (const entry of entries) {
+        let comm = '';
+        try {
+          comm = fs.readFileSync(`/proc/${entry}/comm`, 'utf8').trim();
+        } catch {
+          continue; // process raced away mid-scan
+        }
+        if (comm === unitName) {
+          foundPid = parseInt(entry, 10);
+          break;
+        }
+      }
+      const active = foundPid !== null;
+      return {
+        name,
+        unitName,
+        active,
+        enabled: active,
+        state: active ? 'active' : 'inactive',
+        subState: active ? 'running' : 'dead',
+        pid: foundPid,
+        uptime: null,
+        restartCount: 0,
+        cpuPercent: null,
+        memoryBytes: null,
+        memoryPercent: null,
+        lastChecked: new Date().toISOString(),
+        source: 'process',
+      };
+    } catch {
+      return null;
+    }
+  }
